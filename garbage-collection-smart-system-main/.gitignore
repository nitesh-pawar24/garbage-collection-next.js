# Root .gitignore for monorepo

# Environment files - NEVER commit these
.env
**/.env
backend/.env
admin-frontend/.env
user-frontend/.env
super-admin-frontend/.env

# Dependencies
node_modules/
**/node_modules/

# Next.js build output
.next/
**/.next/

# Expo / React Native
.expo/
**/.expo/
dist/
**/dist/
web-build/
**/web-build/
ios/
**/ios/
android/
**/android/

# Editor & OS
.vscode/
**/.vscode/
*.log
.DS_Store